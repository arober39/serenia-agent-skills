ANTHROPIC_API_KEY=your-anthropic-api-key
LD_SDK_KEY=your-launchdarkly-server-side-sdk-key
LD_CLIENT_SIDE_ID=your-launchdarkly-client-side-id
AIRTABLE_PAT=your-airtable-personal-access-token
AIRTABLE_BASE_ID=your-airtable-base-id

# Datadog Agent (required for the dual-ship tutorial)
DD_API_KEY=your-datadog-api-key
DD_SITE=datadoghq.com
DD_AGENT_HOST=localhost
DD_SERVICE=serenia-agent
DD_ENV=demo

# Routes traces to the correct LaunchDarkly project. Use your client-side ID.
OTEL_RESOURCE_ATTRIBUTES=launchdarkly.project_id=your-launchdarkly-client-side-id
